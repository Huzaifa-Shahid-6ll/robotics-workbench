{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:robotics-workbench:companion-control:1",
  "title": "Connection lifecycle control; not a project operation",
  "type": "object",
  "properties": {
    "schemaVersion": { "const": 1 },
    "requestId": { "type": "string", "format": "uuid" },
    "method": { "enum": ["companion.hello", "companion.shutdown"] },
    "params": { "type": "object", "maxProperties": 0 }
  },
  "required": ["schemaVersion", "requestId", "method", "params"],
  "additionalProperties": false
}

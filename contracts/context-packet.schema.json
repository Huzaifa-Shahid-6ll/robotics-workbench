{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:robotics-workbench:context-packet:1",
  "title": "Application-owned context packet",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "packetId": {
      "type": "string",
      "format": "uuid"
    },
    "projectId": {
      "type": "string",
      "format": "uuid"
    },
    "projectRevision": {
      "type": "integer",
      "minimum": 1
    },
    "sourceSnapshotId": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "assembledAt": {
      "type": "string",
      "format": "date-time"
    },
    "task": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "selection": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "component",
                "net",
                "source",
                "experiment",
                "document",
                "artifact"
              ]
            },
            "id": {
              "type": "string",
              "format": "uuid"
            },
            "revision": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "kind",
            "id",
            "revision"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "recording-range"
            },
            "recordingId": {
              "type": "string",
              "format": "uuid"
            },
            "channelIds": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            },
            "startMs": {
              "type": "number",
              "minimum": 0
            },
            "endMs": {
              "type": "number",
              "minimum": 0
            },
            "timeBasis": {
              "enum": [
                "host-receive",
                "device",
                "relative"
              ]
            },
            "parserVersion": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "projectRevision": {
              "type": "integer",
              "minimum": 1
            },
            "derivationId": {
              "type": "string",
              "format": "uuid"
            },
            "configurationSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "recordingProjectRevision": {
              "type": "integer",
              "minimum": 1
            },
            "deviceEpoch": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "kind",
            "recordingId",
            "channelIds",
            "startMs",
            "endMs",
            "timeBasis",
            "parserVersion",
            "projectRevision"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "document-page"
            },
            "documentId": {
              "type": "string",
              "format": "uuid"
            },
            "artifactSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "extractorVersion": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "page": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2000
            },
            "region": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "projectRevision": {
              "type": "integer",
              "minimum": 1
            },
            "textRange": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 262144
              }
            }
          },
          "required": [
            "kind",
            "documentId",
            "artifactSha256",
            "extractorVersion",
            "page",
            "projectRevision"
          ],
          "additionalProperties": false
        }
      ]
    },
    "current": {
      "type": "object",
      "properties": {
        "targetFqbn": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "deviceId": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "connectionState": {
          "enum": [
            "disconnected",
            "available",
            "monitoring",
            "releasing-monitor",
            "uploading",
            "reconnecting",
            "blocked",
            "outcome-unknown",
            "unknown"
          ]
        },
        "latestBuildId": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "lastUploadReceiptId": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "physicalConfirmation": {
          "enum": [
            "confirmed",
            "unconfirmed",
            "stale",
            "conflicting",
            "not-applicable"
          ]
        },
        "activeOperationIds": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "required": [
        "targetFqbn",
        "deviceId",
        "connectionState",
        "latestBuildId",
        "lastUploadReceiptId",
        "physicalConfirmation",
        "activeOperationIds"
      ],
      "additionalProperties": false
    },
    "constraints": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      }
    },
    "evidenceRefs": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "conflicts": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      }
    },
    "unknowns": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      }
    },
    "omitted": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "properties": {
          "reason": {
            "enum": [
              "budget",
              "excluded",
              "unavailable",
              "unsupported",
              "stale"
            ]
          },
          "ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "expansionHandle": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "reason",
          "ref",
          "expansionHandle"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "packetId",
    "projectId",
    "projectRevision",
    "sourceSnapshotId",
    "assembledAt",
    "task",
    "selection",
    "current",
    "constraints",
    "evidenceRefs",
    "conflicts",
    "unknowns",
    "omitted"
  ],
  "additionalProperties": false,
  "$defs": {
    "evidence": {
      "type": "object",
      "properties": {
        "evidenceId": {
          "type": "string",
          "format": "uuid"
        },
        "artifactId": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "basis": {
          "enum": [
            "planned",
            "reported",
            "measured",
            "inferred"
          ]
        },
        "sourceUri": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "location": {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "whole",
                "lines",
                "page",
                "recording-range"
              ]
            },
            "start": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "end": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "timeBasis": {
              "enum": [
                "host-receive",
                "device",
                "relative",
                null
              ]
            }
          },
          "required": [
            "kind",
            "start",
            "end",
            "timeBasis"
          ],
          "additionalProperties": false
        },
        "projectRevision": {
          "type": "integer",
          "minimum": 1
        },
        "observedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "applicability": {
          "enum": [
            "current",
            "historical",
            "stale",
            "conflicting",
            "unknown"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      },
      "required": [
        "evidenceId",
        "artifactId",
        "sha256",
        "basis",
        "sourceUri",
        "location",
        "projectRevision",
        "observedAt",
        "applicability",
        "summary"
      ],
      "additionalProperties": false
    }
  }
}

  },
  "chartPalette": {
    "status": "proposed-requires-theme-contrast-validation",
    "colors": [
      "#0072B2",
      "#E69F00",
      "#009E73",
      "#CC79A7",
      "#56B4E9",
      "#D55E00"
    ],
    "pairWithPatterns": true,
    "stableSeriesMapping": true,
    "maximumDefaultVisibleSeries": 6
  },
  "rules": [
    "Host theme overrides brand palettes.",
    "Color is never the sole status channel.",
    "Dimensions are minima and expand for zoom/font settings.",
    "Missing theme variables require role-preserving fallback during implementation.",
    "Chart palette requires active-background contrast validation and labelled data alternative."

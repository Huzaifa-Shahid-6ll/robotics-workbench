    "proseLineHeight": 1.45,
    "logLineHeight": 1.5,
    "localTitleEm": 1.15,
    "localTitleWeight": 600,
    "minimumMetadataPx": 12,
    "respectLargerHostPreference": true
  },
  "elevation": {
    "defaultShadow": "none",
    "overlayShadowColor": "var(--vscode-widget-shadow)",

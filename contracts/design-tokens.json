      "css": "var(--vscode-focusBorder)"
    },
    "link": {
      "css": "var(--vscode-textLink-foreground)"
    },
    "fieldBackground": {
      "css": "var(--vscode-input-background)"
    },
    "fieldText": {
      "css": "var(--vscode-input-foreground)"
    },
    "fieldBorder": {
      "css": "var(--vscode-input-border, var(--vscode-contrastBorder, transparent))"
    },
    "actionPrimaryBackground": {
      "css": "var(--vscode-button-background)"
    },
    "actionPrimaryText": {
      "css": "var(--vscode-button-foreground)"
    },
    "actionPrimaryHover": {
      "css": "var(--vscode-button-hoverBackground)"
    },
    "selectionBackground": {
      "css": "var(--vscode-list-activeSelectionBackground)"
    },
    "selectionText": {
      "css": "var(--vscode-list-activeSelectionForeground)"
    },
    "errorText": {
      "css": "var(--vscode-errorForeground)"
    },
    "uiFont": {
      "family": "var(--vscode-font-family)",
      "size": "var(--vscode-font-size)",
      "weight": "var(--vscode-font-weight)"
    },
    "codeFont": {
      "family": "var(--vscode-editor-font-family)",
      "size": "var(--vscode-editor-font-size)",
      "weight": "var(--vscode-editor-font-weight)"
    }
  },
  "geometry": {
    "unit": "css-px",
    "spaceScale": [
      4,
      8,
      12,
      16,
      24,
      32
    ],
    "relatedGap": 8,
    "iconGroupGap": 4,
    "panelPadding": 12,
    "tableCellPaddingHorizontal": 8,
    "controlRadius": 4,
    "contentRadius": 6,
    "separatorWidth": 1,
    "focusWidth": 2,
    "focusOffset": 2,
    "minimumControlTarget": 24,
    "visibleIcon": 16,
    "minimumTableRow": 28

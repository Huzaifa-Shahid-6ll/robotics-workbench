{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:robotics-workbench:event:1",
  "title": "event",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "projectId": {
      "type": "string",
      "format": "uuid"
    },
    "projectRevision": {
      "type": "integer",
      "minimum": 1
    },
    "operationId": {
      "type": "string",
      "format": "uuid"
    },
    "type": {
      "type": "string",
      "minLength": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object"
    }
  },
  "required": [
    "schemaVersion",
    "eventId",
    "sequence",
    "projectId",
    "projectRevision",
    "type",
    "occurredAt",
    "payload"
  ],
  "additionalProperties": false
}

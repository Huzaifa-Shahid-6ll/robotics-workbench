{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:robotics-workbench:operation-receipt:1",
  "title": "operation-receipt",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "operationId": {
      "type": "string",
      "format": "uuid"
    },
    "projectId": {
      "type": "string",
      "format": "uuid"
    },
    "kind": {
      "enum": [
        "compile",
        "upload",
        "serial-capture",
        "kicad-export",
        "cad-generate",
        "document-ingest",
        "experiment-record"
      ]
    },
    "status": {
      "enum": [
        "queued",
        "running",
        "awaiting-input",
        "succeeded",
        "failed",
        "cancelled",
        "outcome-unknown"
      ]
    },
    "expectedProjectRevision": {
      "type": "integer",
      "minimum": 1
    },
    "sourceSnapshotId": {
      "type": "string",
      "format": "uuid"
    },
    "deviceId": {
      "type": "string",
      "format": "uuid"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "finishedAt": {
      "type": "string",
      "format": "date-time"
    },
    "tool": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "artifactId": {
            "type": "string",
            "format": "uuid"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "mediaType": {
            "type": "string",
            "minLength": 1
          },
          "relativePath": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "artifactId",
          "sha256",
          "mediaType",
          "relativePath"
        ],
        "additionalProperties": false
      }
    },
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "retryable": {
          "type": "boolean"
        },
        "details": {
          "type": "object"
        }
      },
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "additionalProperties": false
    },
    "reconcilesOperationId": {
      "type": "string",
      "format": "uuid"
    },
    "requestId": {
      "type": "string",
      "format": "uuid"
    },
    "result": {
      "type": "object"
    }
  },
  "required": [
    "schemaVersion",
    "operationId",
    "projectId",
    "kind",
    "status",
    "expectedProjectRevision",
    "createdAt",
    "tool",
    "artifacts",
    "requestId"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "upload"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "deviceId",
          "sourceSnapshotId"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "succeeded",
              "failed",
              "cancelled",
              "outcome-unknown"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "finishedAt"
        ]
      }
    }
  ]
}

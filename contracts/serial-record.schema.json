{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Raw serial received record v1",
  "description": "SPECIFIED application contract. Only received bytes; gap events use a separate event contract. Validate formats explicitly. No hardware execution implied.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "recordingId",
    "connectionSessionId",
    "sequence",
    "hostElapsedNs",
    "hostReceivedAt",
    "bytesBase64",
    "quality"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "recordingId": {
      "type": "string",
      "format": "uuid"
    },
    "connectionSessionId": {
      "type": "string",
      "format": "uuid"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "hostElapsedNs": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "hostReceivedAt": {
      "type": "string",
      "format": "date-time"
    },
    "bytesBase64": {
      "type": "string",
      "minLength": 4,
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
    },
    "quality": {
      "const": "received"
    }
  }
}

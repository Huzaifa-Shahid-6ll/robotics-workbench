{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://robotics-workbench.local/contracts/task-packet.schema.json",
  "title": "Normative implementation task index",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "tasks"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "tasks": {
      "type": "array",
      "minItems": 13,
      "maxItems": 13,
      "items": {
        "$ref": "#/$defs/task"
      }
    }
  },
  "$defs": {
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "title",
        "status",
        "depends_on",
        "read",
        "write_scope",
        "contract_inputs",
        "outputs",
        "acceptance",
        "stop_conditions",
        "evidence_class",
        "exclusions",
        "validation_gates",
        "release_gate",
        "prerequisite_gates"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "pattern": "^TASK-[0-9]{2}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "blocked",
            "ready",
            "in-progress",
            "review",
            "done"
          ]
        },
        "depends_on": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^TASK-[0-9]{2}$"
          }
        },
        "read": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^D[0-9]{2}$"
          }
        },
        "write_scope": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "contract_inputs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "acceptance": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^AC-D[0-9]{2}-[0-9]{2}$"
          }
        },
        "stop_conditions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence_class": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "document",
              "software",
              "live-provider",
              "packaged-windows",
              "real-hardware",
              "manual-ui"
            ]
          }
        },
        "exclusions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "validation_gates": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^VG-[0-9]{2}$"
          },
          "description": "Gates this task resolves before its release claim is accepted; not prerequisites to start probe or implementation work."
        },
        "release_gate": {
          "enum": [
            "G0",
            "G1",
            "G2",
            "G3",
            "G4",
            "G5",
            "G6"
          ]
        },
        "conditional_validation_gates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "gate_id",
              "when"
            ],
            "properties": {
              "gate_id": {
                "type": "string",
                "pattern": "^VG-[0-9]{2}$"
              },
              "when": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "prerequisite_gates": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^VG-[0-9]{2}$"
          },
          "description": "Already passed gates required before starting dependent effectful work."
        }
      }
    }
  }
}
